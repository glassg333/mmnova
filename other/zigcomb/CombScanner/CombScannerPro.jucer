<?xml version="1.0" encoding="UTF-8"?>
<JUCERPROJECT id="CSPro01" name="CombScannerPro" projectType="audioplug" version="1.0.0"
              jucerFormatVersion="1" cppLanguageStandard="17"
              companyName="GlassG333" companyWebsite="https://github.com/glassg333/mmnova"
              companyCopyright="GlassG333"
              bundleIdentifier="com.glassg333.combscannerpro"
              useAppConfig="1" addUsingNamespaceToJuceHeader="0"
              defines="JUCE_VST3_CAN_REPLACE_VST2=0"
              headerPath="../../Source;../../ThirdParty/SignalsmithDSP"
              pluginName="Comb Scanner Pro"
              pluginDesc="Multi-comb resonator, scanner, insert FX and modulation sequencer"
              pluginManufacturer="GlassG333" pluginManufacturerCode="GgSt" pluginCode="CbSc"
              pluginFormats="buildVST3" pluginCharacteristicsValue="pluginWantsMidiIn"
              pluginVST3Category="Fx">
  <EXPORTFORMATS>
    <VS2022 targetFolder="Builds/VisualStudio2022">
      <CONFIGURATIONS>
        <CONFIGURATION name="Debug" isDebug="1" targetName="CombScannerPro"
                       optimisation="1" linkTimeOptimisation="0" winArchitecture="x64"
                       extraCompilerFlags="/utf-8"/>
        <CONFIGURATION name="Release" isDebug="0" targetName="CombScannerPro"
                       optimisation="3" linkTimeOptimisation="0" winArchitecture="x64"
                       extraCompilerFlags="/utf-8"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_processors_headless" path="C:/JUCE/modules"/>
      </MODULEPATHS>
    </VS2022>
  </EXPORTFORMATS>
  <MAINGROUP id="CSRoot01" name="CombScannerPro">
    <GROUP id="CSSource" name="Source">
      <GROUP id="CSDSP" name="DSP">
        <FILE id="CSEngineCpp" name="CombScannerEngine.cpp" compile="1" resource="0" file="Source/DSP/CombScannerEngine.cpp"/>
        <FILE id="CSEngineH" name="CombScannerEngine.h" compile="0" resource="0" file="Source/DSP/CombScannerEngine.h"/>
      </GROUP>
      <GROUP id="CSUI" name="UI">
        <FILE id="CSLookH" name="DarkLookAndFeel.h" compile="0" resource="0" file="Source/UI/DarkLookAndFeel.h"/>
      </GROUP>
      <FILE id="CSProcessorCpp" name="PluginProcessor.cpp" compile="1" resource="0" file="Source/PluginProcessor.cpp"/>
      <FILE id="CSProcessorH" name="PluginProcessor.h" compile="0" resource="0" file="Source/PluginProcessor.h"/>
      <FILE id="CSParametersCpp" name="PluginParameters.cpp" compile="1" resource="0" file="Source/PluginParameters.cpp"/>
      <FILE id="CSParametersH" name="PluginParameters.h" compile="0" resource="0" file="Source/PluginParameters.h"/>
      <FILE id="CSEditorCpp" name="PluginEditor.cpp" compile="1" resource="0" file="Source/PluginEditor.cpp"/>
      <FILE id="CSEditorH" name="PluginEditor.h" compile="0" resource="0" file="Source/PluginEditor.h"/>
    </GROUP>
    <GROUP id="CSReference" name="Reference">
      <FILE id="CSImage" name="combscanner_upgrade_reference.jpg" compile="0" resource="0" file="Resources/combscanner_upgrade_reference.jpg"/>
    </GROUP>
    <GROUP id="CSThirdParty" name="ThirdParty">
      <FILE id="CSSignalsReadme" name="README.md" compile="0" resource="0" file="ThirdParty/SignalsmithDSP/README.md"/>
      <FILE id="CSSignalsLicense" name="LICENSE.txt" compile="0" resource="0" file="ThirdParty/SignalsmithDSP/LICENSE.txt"/>
      <FILE id="CSSignalsCommon" name="common.h" compile="0" resource="0" file="ThirdParty/SignalsmithDSP/common.h"/>
      <FILE id="CSSignalsFFT" name="fft.h" compile="0" resource="0" file="ThirdParty/SignalsmithDSP/fft.h"/>
      <FILE id="CSSignalsPerf" name="perf.h" compile="0" resource="0" file="ThirdParty/SignalsmithDSP/perf.h"/>
    </GROUP>
  </MAINGROUP>
  <JUCEOPTIONS JUCE_WEB_BROWSER="0" JUCE_USE_CURL="0"
               JUCE_DISPLAY_SPLASH_SCREEN="0" JUCE_REPORT_APP_USAGE="0"/>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_plugin_client" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_processors_headless" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_utils" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
  </MODULES>
</JUCERPROJECT>
