diff --git a/JUCE/Monomachine-Nova-1.6.1/Monomachine_Nova_FX/Source/dsp/mnm/MnmDistOriginal.hpp b/JUCE/Monomachine-Nova-1.6.1/Monomachine_Nova_FX/Source/dsp/mnm/MnmDistOriginal.hpp
new file mode 100644
index 0000000..9e0407d
--- /dev/null
+++ b/JUCE/Monomachine-Nova-1.6.1/Monomachine_Nova_FX/Source/dsp/mnm/MnmDistOriginal.hpp
@@ -0,0 +1,58 @@
+#pragma once
+// MnmDistOriginal.hpp
+//
+// DIST stage adapted from:
+//   decompiled data/MNM BLOCKS FOR JUCE/5 mnm-dist-filter/Source/mmnova/MnMAmpDist.h
+//
+// The recovered behavior is not a tanh or soft clip. The DSP multiplies by a
+// fixed-point gain and writes through the DSP56300 saturation flag SR.SM
+// (bset #$14,sr), which hard-clips the 24-bit word. The ColdFire display-to-
+// gain curve is not present in the available DSP listing, so the exponential
+// curve below is an explicit approximation; the fixed-point multiply and hard
+// clip are the recovered parts.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace monomachine {
+namespace mnm {
+
+class MnmDistOriginal {
+public:
+    void setRaw(float raw0to127) noexcept {
+        const int display = std::clamp(static_cast<int>(std::lround(raw0to127)), 0, 127) - 64;
+        // MnMAmpDist.h: display 0 is unity; the intermediate curve is not
+        // proven, so keep it isolated to this one function.
+        const double gain = std::clamp(std::exp2(static_cast<double>(display) / 16.0), 0.0, 7.999);
+        gain_ = toWord(gain);
+    }
+
+    void reset() noexcept {}
+
+    float process(float input) const noexcept {
+        const Word x = toWord(input);
+        const Word product = sat24((static_cast<std::int64_t>(x) * gain_) >> 23);
+        return static_cast<float>(product) / 8388608.0f;
+    }
+
+    float gain() const noexcept { return static_cast<float>(gain_) / 8388608.0f; }
+
+private:
+    using Word = std::int32_t;
+
+    static Word toWord(double value) noexcept {
+        const double scaled = std::clamp(value * 8388608.0, -8388608.0, 8388607.0);
+        return static_cast<Word>(std::llround(scaled));
+    }
+
+    static Word sat24(std::int64_t value) noexcept {
+        if (value > 0x7FFFFF) return 0x7FFFFF;
+        if (value < -0x800000) return -0x800000;
+        return static_cast<Word>(value);
+    }
+
+    Word gain_ = toWord(1.0);
+};
+
+}  // namespace mnm
+}  // namespace monomachine
